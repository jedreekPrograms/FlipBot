        "pull_request": {
          "url": "https://api.github.com/repos/jedreekPrograms/VintedOfferTracker/pulls/236",
          "html_url": "https://github.com/jedreekPrograms/VintedOfferTracker/pull/236",
          "diff_url": "https://github.com/jedreekPrograms/VintedOfferTracker/pull/236.diff",
