        "pull_request": {
          "url": "https://api.github.com/repos/jedreekPrograms/VintedOfferTracker/pulls/131",
          "html_url": "https://github.com/jedreekPrograms/VintedOfferTracker/pull/131",
          "diff_url": "https://github.com/jedreekPrograms/VintedOfferTracker/pull/131.diff",
