        "pull_request": {
          "url": "https://api.github.com/repos/jedreekPrograms/VintedOfferTracker/pulls/36",
          "html_url": "https://github.com/jedreekPrograms/VintedOfferTracker/pull/36",
          "diff_url": "https://github.com/jedreekPrograms/VintedOfferTracker/pull/36.diff",
