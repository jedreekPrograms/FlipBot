          "url": "https://api.github.com/repos/jedreekPrograms/VintedOfferTracker/pulls/39",
          "html_url": "https://github.com/jedreekPrograms/VintedOfferTracker/pull/39",
          "diff_url": "https://github.com/jedreekPrograms/VintedOfferTracker/pull/39.diff",
