        "pull_request": {
          "url": "https://api.github.com/repos/jedreekPrograms/VintedOfferTracker/pulls/118",
          "html_url": "https://github.com/jedreekPrograms/VintedOfferTracker/pull/118",
          "diff_url": "https://github.com/jedreekPrograms/VintedOfferTracker/pull/118.diff",
