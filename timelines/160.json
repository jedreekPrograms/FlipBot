        "pull_request": {
          "url": "https://api.github.com/repos/jedreekPrograms/VintedOfferTracker/pulls/161",
          "html_url": "https://github.com/jedreekPrograms/VintedOfferTracker/pull/161",
          "diff_url": "https://github.com/jedreekPrograms/VintedOfferTracker/pull/161.diff",
