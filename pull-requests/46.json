  "title": "Allow lowering negotiation cap below active offer",
  "user": {
    "login": "jedreekPrograms",
    "id": 221845274,
    "node_id": "U_kgDODTkXGg",
    "avatar_url": "https://avatars.githubusercontent.com/u/221845274?v=4",
